ARG REDIS_IMAGE=redis:7.4-alpine
FROM ${REDIS_IMAGE}

RUN mkdir -p /data && chown redis:redis /data

USER redis
WORKDIR /data
EXPOSE 6379

CMD ["redis-server", \
    "--appendonly", "yes", \
    "--appendfsync", "everysec", \
    "--auto-aof-rewrite-percentage", "100", \
    "--auto-aof-rewrite-min-size", "64mb"]
