RAILYARD_IMAGE_TAG=local
RAILYARD_REDIS_IMAGE_TAG=7.4-local

RAILYARD_HTTP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

RAILYARD_LISTEN_ADDRESS=:8080
RAILYARD_DB_PATH=/var/lib/railyard/railyard.db
RAILYARD_REDIS_URL=redis://redis:6379/0
RAILYARD_SERVER_URL=http://server:8080
RAILYARD_WORKER_SLOTS=16
RAILYARD_ALLOW_SHELL=false

PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-before-shared-use

GO_IMAGE=golang:1.26.6-alpine
RUNTIME_IMAGE=alpine:3.22
REDIS_IMAGE=redis:7.4-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
GRAFANA_IMAGE=grafana/grafana:12.1.0
